# このファイルを .env にコピーしてください。
# Cosmos DB / Firebase を設定しなければローカルの data/store.json と通常ログインを使います。

# Azure PortalのCosmos DBアカウント「キー」ページで確認できます。
COSMOS_ENDPOINT=
COSMOS_KEY=

# 省略可(デフォルトのままで問題なければ書かなくてOK)
COSMOS_DATABASE=rapan
COSMOS_CONTAINER=state

# Googleログインを使う場合: Firebase ConsoleでAuthenticationのGoogleプロバイダを有効にします。
# Firebase Webアプリ設定から取得してください (VITE_ values are exposed to the browser).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Firebase Admin SDKのサービスアカウント設定です (サーバーだけで使います)。
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
